@model IEnumerable<Donaldson_Mottors.Models.Booking>

@{
    ViewBag.Title = "BookingsToRaise";
}

<h2>Bookings To Raise</h2> <!--Original app-->

<table class="table text-white">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.DateOfBooking)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Customer.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JobDescription)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TotalCost)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.DateOfBooking)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Customer.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.JobDescription)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CompletionStatus)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TotalCost)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AmountPaid)
        </td>
        <td>
            @using (Html.BeginForm("Raise", "Invoices", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("id", item.BookingId)

                <button type="submit" class="btn btn-primary">
                    Raise Invoice
                </button>
            }
        </td>
    </tr>
}

</table>
