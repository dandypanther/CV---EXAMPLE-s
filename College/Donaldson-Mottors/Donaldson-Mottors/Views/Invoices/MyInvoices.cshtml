@model IEnumerable<Donaldson_Mottors.Models.Invoice>

@{
    ViewBag.Title = "MyInvoices";
}

<h2>My Invoices</h2>

<table class="table text-white">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Booking.JobDescription)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CompanyAddress)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CompanyInfo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CustomerName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CustomerAddress)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CustomerContactInfo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LabourCost)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ProductCost)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TotalCost)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.NoHrs)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Booking.JobDescription)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CompanyAddress)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CompanyInfo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CustomerName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CustomerAddress)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CustomerContactInfo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.LabourCost)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ProductCost)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TotalCost)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.NoHrs)
        </td>
        <td>
            @Html.ActionLink("View Invoice", "ViewInvoice", new { id = item.InvoiceNo })
        </td>
    </tr>
}

</table>
