@model Donaldson_Mottors.Models.ChangeDetailsViewModelStaff

@using (Html.BeginForm("ChangeDetailsStaff", "Manage", FormMethod.Post, new { role = "form" }))
{
    @Html.AntiForgeryToken()

    <h4>Edit your Profile's details</h4>
    <hr />

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <!-- Email -->
    <div class="row">
        @Html.LabelFor(m => m.Email, new { @class = "col-md-2 col-form-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        </div>
    </div>

    <!-- Name -->
    <div class="row">
        @Html.LabelFor(m => m.Name, new { @class = "col-md-2 col-form-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        </div>
    </div>

    <!-- Position -->
    <div class="row">
        @Html.LabelFor(m => m.Position, new { @class = "col-md-2 col-form-label" })
        <div class="col-md-10">
            @Html.DisplayFor(m => m.Position)
        </div>
    </div>

    @Html.HiddenFor(model => model.Position)

    <!-- Address -->
    <div class="row">
        @Html.LabelFor(m => m.Address, new { @class = "col-md-2 col-form-label" })
        <div class="col-md-10">
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
            @Html.EditorFor(m => m.Address, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>

    <!-- Date of Birth -->
    <div class="row">
        @Html.LabelFor(m => m.DateOfBirth, new { @class = "col-md-2 col-form-label" })
        <div class="col-md-10">
            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
            @Html.EditorFor(m => m.DateOfBirth, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>



    <!-- Password -->
    <div class="row">
        @Html.LabelFor(m => m.Password, new { @class = "col-md-2 col-form-label" })
        <div class="col-md-10">
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
        </div>
    </div>

    <!-- Confirm Password -->
    <div class="row">
        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-2 col-form-label" })
        <div class="col-md-10">
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
        </div>
    </div>

    <br />

    <!-- Submit -->
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Update Details" class="btn btn-primary" />
        </div>
    </div>
}