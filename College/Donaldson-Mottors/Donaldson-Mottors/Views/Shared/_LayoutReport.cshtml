@{ 

    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@DateTime.Now.Date Stock Report</title>
    @*@Styles.Render("~/Content/css")*@
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">

            <img src="@Url.Content("~/Images/logo.jpg")"
                 alt="DonaldsonMottors"
                 style="width:10%; height:auto; border-radius:35px;" class="brand-image">

            <h1>@DateTime.Now.ToString("yyyy-MM-dd") </h1>
        </div>
    </nav>
    <div style="padding:0; margin:0;">
        @RenderBody()
        <hr />
        <div style="margin-top:20px;">
            <img src="@Url.Content("~/Images/logo.jpg")"
                 alt="DonaldsonMottors"
                 style="width:5%; height:auto; border-radius:35px;" class="brand-image">
            <br />
            <p>&copy; @DateTime.Now.Year - Donaldson Mottors Developed by Grant E Dunnington</p>
        </div>
        </div>

    

    @Scripts.Render("~/bundles/jquery")
    @*@Scripts.Render("~/bundles/bootstrap")*@
    @RenderSection("scripts", required: false)
</body>
</html>
